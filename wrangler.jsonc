{
    "name": "ws-os",
    "main": "./worker/index.js",
    "compatibility_date": "2026-10-15",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
    },
    "d1_databases": [
        {
            "binding": "WALLY_LIMITS_DB",
            "database_name": "ws-os-wally-limits",
            "database_id": "f5be0f0e-3a31-4ec3-b8d5-510e0c7ab555"
        }
    ],
    "vars": {
        "WALLY_AI_ENABLED": "false",
        "GEMINI_MODEL": "gemini-3.8-flash",
        "SUPABASE_URL": "https://nkzybphguyjvxglcwbik.supabase.co",
        "REQUESTS_ENABLED": "true",
        "MANAGED_FILES_ENABLED": "true",
        "RANKINGS_ENABLED": "true",
        "REQUEST_RETENTION_ENABLED": "true"
    },
    "triggers": {
        "crons": [
            "0 3 * * *"
        ]
    }
}